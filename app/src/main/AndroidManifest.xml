<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Android 11+ filters PackageManager results unless the queried app is
        visible. TestLoop checks only the explicitly committed app, and every
        Play app a member can commit to is expected to expose a launcher
        activity. Without this query, an installed app such as
        com.flipkart.android can be reported as absent and never activate the
        tester commitment.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/testloop_launcher"
        android:label="TestLoop"
        android:roundIcon="@mipmap/testloop_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TestLoop">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="testloop" android:host="auth-callback" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".notifications.EveningReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.testloop.app.action.EVENING_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
